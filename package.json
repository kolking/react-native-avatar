{
  "name": "@kolking/react-native-avatar",
  "version": "2.1.6",
  "description": "Display user avatars in React Native like a pro with support for Gravatar, user initials, unique colors, badges, statuses, and more.",
  "author": "Nick Seryakov (https://github.com/kolking)",
  "license": "MIT",
  "homepage": "https://github.com/kolking/react-native-avatar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://kolking@github.com/kolking/react-native-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/kolking/react-native-avatar/issues"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "userpic",
    "avatar",
    "gravatar",
    "avatar image",
    "user picture",
    "user image",
    "user avatar",
    "initials",
    "badge"
  ],
  "main": "src/index",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "start": "cd example && yarn ios:dev",
    "test": "jest --passWithNoTests",
    "coverage": "yarn test --coverage",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx ./",
    "validate": "yarn tsc && yarn lint --fix && yarn test -u",
    "validate-ci": "yarn tsc && yarn lint && yarn coverage",
    "install-all": "yarn && cd example && yarn && npx pod-install"
  },
  "dependencies": {
    "js-md5": "^0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/js-md5": "^0.7.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "3.10.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
